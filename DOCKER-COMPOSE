version: '3.9'

services:

  db:
    image: mysql:8
    container_name: agri-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: agri
    ports:
      - "3307:3306"

  backend:
    build: ./backend
    container_name: agri-backend
    ports:
      - "8080:8080"
    depends_on:
      - db
      - ai
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://db:3306/agri
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: root

  ai:
    build: ./ai-service
    container_name: agri-ai
    ports:
      - "5000:5000"